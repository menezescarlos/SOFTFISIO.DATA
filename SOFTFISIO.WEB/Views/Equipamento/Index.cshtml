@model IEnumerable<SOFTFISIO.DATA.Models.Equipamento>

@{
    ViewData["Title"] = "Equipamentos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">

        <h3>Cadastro de Equipamento</h3>

        <a asp-action="Create"
           class="btn btn-primary">
            Novo Equipamento
        </a>

    </div>

    <table class="table table-striped table-bordered table-hover">

        <thead class="table-dark">

            <tr>
                <th>ID</th>
                <th>NomeEquipamento</th>
                <th>Patrimonio</th>
                <th>NomeEquipamento</th>
                <th>DataAquisicao</th>
                <th>Status</th>
                <th width="220">Ações</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.IdEquipamento</td>

                    <td>@item.NomeEquipamento</td>

                    <td>@item.Patrimonio</td>

                    <td>@item.DataAquisicao</td>

                    <td>@item.Ativo</td>

                    <td>

                        @if (item.Ativo == true)
                        {
                            <span class="badge bg-success">
                                Ativa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inativa
                            </span>
                        }

                    </td>

                    <td>

                        <div class="d-flex gap-2">

                            <a asp-action="Details"
                               asp-route-id="@item.IdEquipamento"
                               class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i>
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.IdEquipamento"
                               class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.IdEquipamento"
                               class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i>
                                Excluir
                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
