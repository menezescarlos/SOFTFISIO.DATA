<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SOFTFISIO</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SOFTFISIO.WEB.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- MENU PRINCIPAL -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark">

            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    SOFTFISIO

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSoftfisio">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarSoftfisio">

                    <ul class="navbar-nav me-auto">

                        <!-- CADASTROS -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="cadastrosDropdown"
                               role="button"
                               data-bs-toggle="dropdown">

                                Cadastros

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Empresa"
                                       asp-action="Index">
                                        Empresa
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Cooperativa"
                                       asp-action="Index">
                                        Cooperativa
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Funcionario"
                                       asp-action="Index">
                                        Funcionário
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Paciente"
                                       asp-action="Index">
                                        Paciente
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Sala"
                                       asp-action="Index">
                                        Sala
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Equipamento"
                                       asp-action="Index">
                                        Equipamento
                                    </a>
                                </li>

                            </ul>

                        </li>

                        <!-- CLÍNICO -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="clinicoDropdown"
                               role="button"
                               data-bs-toggle="dropdown">

                                Clínico

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Prontuario"
                                       asp-action="Index">
                                        Prontuário
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Atendimento"
                                       asp-action="Index">
                                        Atendimento
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="EvolucaoClinica"
                                       asp-action="Index">
                                        Evolução Clínica
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="PlanoTratamento"
                                       asp-action="Index">
                                        Plano de Tratamento
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Procedimento"
                                       asp-action="Index">
                                        Procedimentos
                                    </a>
                                </li>

                            </ul>

                        </li>

                        <!-- AGENDA -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="agendaDropdown"
                               role="button"
                               data-bs-toggle="dropdown">

                                Agenda

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Agendamento"
                                       asp-action="Index">
                                        Agendamento
                                    </a>
                                </li>

                            </ul>

                        </li>

                        <!-- AJUDA -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Ajuda

                            </a>

                        </li>

                    </ul>

                    <!-- LADO DIREITO -->

                    <div class="d-flex align-items-center">

                        <span class="usuario-logado me-3">
                            Bem-vindo
                        </span>

                        <a href="#"
                           class="btn btn-outline-light btn-sm">

                            Sair

                        </a>

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- CONTEÚDO -->

    <div class="container-fluid mt-4">

        <main role="main">

            @RenderBody()

        </main>

    </div>

    <!-- FOOTER -->

    <footer class="footer-softfisio">

        <div class="container-fluid text-center">

            © 2026 SOFTFISIO -
            Sistema de Gestão para Clínicas e Fisioterapeutas

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>