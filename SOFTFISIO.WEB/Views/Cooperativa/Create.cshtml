@model SOFTFISIO.DATA.Models.Cooperativa

@{
    ViewData["Title"] = "Cadastro de Cooperativa";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4>Cadastro de Cooperativa</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Empresa
                        </label>

                        <select asp-for="IdEmpresa"
                                asp-items="ViewBag.Empresas"
                                class="form-select">

                            <option value="">
                                Selecione uma Empresa
                            </option>

                        </select>

                        <span asp-validation-for="IdEmpresa"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="NomeCooperativa"
                               class="form-label">
                        </label>

                        <input asp-for="NomeCooperativa"
                               class="form-control" />

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label asp-for="CNPJ"
                               class="form-label">
                        </label>

                        <input asp-for="CNPJ"
                               class="form-control" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="Telefone"
                               class="form-label">
                        </label>

                        <input asp-for="Telefone"
                               class="form-control" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control" />

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Contato"
                               class="form-label">
                        </label>

                        <input asp-for="Contato"
                               class="form-control" />

                    </div>

                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Situação
                        </label>

                        <select asp-for="Ativa"
                                class="form-select">

                            <option value="true">
                                Ativa
                            </option>

                            <option value="false">
                                Inativa
                            </option>

                        </select>

                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-success">
                    Salvar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}