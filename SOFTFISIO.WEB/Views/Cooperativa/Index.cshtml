@model IEnumerable<SOFTFISIO.DATA.Models.Cooperativa>

@{
    ViewData["Title"] = "Cooperativas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">

        <h3>Cooperativas Cadastradas</h3>

        <a asp-action="Create"
           class="btn btn-primary">
            Nova Cooperativa
        </a>

    </div>

    <table class="table table-striped table-bordered table-hover">

        <thead class="table-dark">

            <tr>
                <th>ID</th>
                <th>Cooperativa</th>
                <th>CNPJ</th>
                <th>Telefone</th>
                <th>Email</th>
                <th>Contato</th>
                <th>Status</th>
                <th width="220">Ações</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.IdCooperativa</td>

                    <td>@item.NomeCooperativa</td>

                    <td>@item.CNPJ</td>

                    <td>@item.Telefone</td>

                    <td>@item.Email</td>

                    <td>@item.Contato</td>

                    <td>

                        @if (item.Ativa == true)
                        {
                            <span class="badge bg-success">
                                Ativa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inativa
                            </span>
                        }

                    </td>

                    <td>

                        <div class="d-flex gap-2">

                            <a asp-action="Details"
                               asp-route-id="@item.IdCooperativa"
                               class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i>
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.IdCooperativa"
                               class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.IdCooperativa"
                               class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i>
                                Excluir
                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
